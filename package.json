{
  "name": "textbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:opt": "cross-env OPTIMIZE=true next dev --turbopack",
    "build": "npx prisma generate --no-engine && next build",
    "build:turbo": "npx prisma generate --no-engine && next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "npx prisma generate --no-engine",
    "db:dev": "npx prisma dev",
    "db:migrate": "dotenv -e .env.development npx prisma migrate dev",
    "db:seed": "dotenv -e .env.development npx prisma db seed",
    "db:push": "dotenv -e .env.development npx prisma db push",
    "db:pull": "dotenv -e .env.development npx prisma db pull",
    "db:gen": "dotenv -e .env.development npx prisma generate",
    "db:studio": "dotenv -e .env.development npx prisma studio"
  },
  "dependencies": {
    "@conform-to/react": "^1.13.2",
    "@conform-to/zod": "^1.13.2",
    "@epic-web/remember": "^1.1.0",
    "@prisma/client": "^6.16.2",
    "@prisma/extension-accelerate": "^2.0.2",
    "@prisma/extension-optimize": "^2.0.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/html": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "chalk": "^5.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "lucide-react": "^0.475.0",
    "next": "15.5.6",
    "next-auth": "^5.0.0-beta.29",
    "next-themes": "^0.4.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-error-boundary": "^5.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.0.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.23",
    "@types/react": "19.1.15",
    "@types/react-dom": "19.1.9",
    "dotenv-cli": "^10.0.0",
    "enforce-unique": "^1.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.5.6",
    "prisma": "^6.16.2",
    "tailwind": "^4.0.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@types/react": "19.1.15",
    "@types/react-dom": "19.1.9"
  }
}
